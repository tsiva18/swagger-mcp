{
  "name": "@tsiva18/swagger-mcp-server",
  "version": "1.0.1",
  "description": "NestJS-based MCP server for Swagger/OpenAPI documentation inspection",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "swagger-mcp": "./dist/main.js",
    "swagger-mcp-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsiva18/swagger-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "swagger",
    "openapi",
    "nestjs",
    "mcp-server"
  ],
  "author": "Sivaram",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tsiva18/swagger-mcp/issues"
  },
  "homepage": "https://github.com/tsiva18/swagger-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "dotenv": "^16.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
